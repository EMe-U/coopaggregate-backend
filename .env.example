# JDBC format, e.g. jdbc:postgresql://<neon-host>/<database>?sslmode=require
DATABASE_URL=jdbc:postgresql://your-neon-host/your-database?sslmode=require
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
MANAGER_NAME=Cooperative Manager
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=replace-with-a-strong-password
# log (default, sends nothing), africastalking or traccar. Use AT_USERNAME=sandbox with a sandbox API key for testing.
SMS_PROVIDER=log
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
AT_SENDER_ID=
# Only with SMS_PROVIDER=traccar (an Android phone with a SIM running the Traccar SMS Gateway app).
# The URL must be https (http only for localhost). The token is the one shown in the gateway app.
SMS_TRACCAR_URL=https://www.traccar.org/sms/
SMS_TRACCAR_TOKEN=your-traccar-gateway-token
# Long random string. Callback URL: https://<api-host>/api/sms/inbound?token=<SMS_INBOUND_SECRET>
SMS_INBOUND_SECRET=replace-with-a-long-random-secret

# true only for local development with SMS_PROVIDER=log: prints the one-time codes in the console; never on Render
SMS_LOG_SHOW_CODES=false
# TEMPORARY, for the demo only: 6 digits also accepted as the code of any pending delivery. Remove after the demo.
# SMS_DEMO_CODE=<6 digits>

# Member identity verification with MOSIP eSignet. false (default) switches the feature off; members are then
# registered without it. With true, the next five are required or the app does not start.
MOSIP_ENABLED=false
# The eSignet issuer; the authorize, token, userinfo and JWKS URLs follow from it. Plain http only for localhost.
MOSIP_BASE_URL=http://localhost:8080
MOSIP_CLIENT_ID=your-client-id
# Must be registered with eSignet exactly as written; it is a page of the frontend.
MOSIP_REDIRECT_URI=http://localhost:5173/identity/callback
# Path to your RSA private key file (PKCS#8 PEM or JWK), kept outside the repository.
MOSIP_PRIVATE_KEY_PATH=C:/path/to/your-private-key.pem
# The kid of the matching public JWK registered with eSignet.
MOSIP_KEY_ID=your-key-id
# Optional; these are the defaults.
# MOSIP_SCOPE=openid  (the name and phone are asked for with the claims parameter; more scopes bring unused details)
# MOSIP_ACR_VALUES=mosip:idp:acr:password
# MOSIP_ASSERTION_AUDIENCE=<MOSIP_BASE_URL>
# MOSIP_ISSUER=<MOSIP_BASE_URL>  (the exact iss of the id_token and the userinfo answer)
