# JDBC format, e.g. jdbc:postgresql://<neon-host>/<database>?sslmode=require
DATABASE_URL=jdbc:postgresql://your-neon-host/your-database?sslmode=require
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
MANAGER_NAME=Cooperative Manager
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=replace-with-a-strong-password
# log (default, sends nothing) or africastalking. Use AT_USERNAME=sandbox with a sandbox API key for testing.
SMS_PROVIDER=log
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
AT_SENDER_ID=
# Long random string. Callback URL: https://<api-host>/api/sms/inbound?token=<SMS_INBOUND_SECRET>
SMS_INBOUND_SECRET=replace-with-a-long-random-secret

# true only for local development with SMS_PROVIDER=log: prints the one-time codes in the console; never on Render
SMS_LOG_SHOW_CODES=false

# Identity verification at registration. false uses the test verifier, which also needs MOCK_VERIFICATION_ALLOWED=true
MOSIP_ENABLED=false
# With MOSIP_ENABLED=true all four of these are required, or the app does not start. Details to confirm with the supervisor.
MOSIP_BASE_URL=
MOSIP_CLIENT_ID=
MOSIP_REDIRECT_URI=
# Secret: never commit a real value
MOSIP_PRIVATE_KEY=
# true only for local development; never on Render
MOCK_VERIFICATION_ALLOWED=false
